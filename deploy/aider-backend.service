[Unit]
Description=Control Center Qwen RAG Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/system/aider-backend
ExecStart=/root/system/aider-backend/scripts/start.sh
Environment=PYTHONUNBUFFERED=1
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
