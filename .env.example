DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_PLUS_MODEL=qwen3-coder-plus
QWEN_FLASH_MODEL=qwen3-coder-flash

# 故障诊断生成模型：glm 或 qwen。千问使用上方的 DASHSCOPE_API_KEY / BASE_URL。
KNOWLEDGE_PROVIDER=qwen
KNOWLEDGE_QWEN_MODEL=qwen3.8-flash
KNOWLEDGE_QWEN_ENABLE_THINKING=false
KNOWLEDGE_QWEN_MAX_TOKENS=2048
KNOWLEDGE_QWEN_TIMEOUT_SECONDS=60
KNOWLEDGE_QWEN_MAX_CONCURRENCY=2
KNOWLEDGE_QWEN_TEMPERATURE=0.2

GLM_BASE_URL=http://115.190.191.103:8081/v1
GLM_API_KEY=not-needed
GLM_MODEL=glm
# 知识问答默认关闭深度推理，减少等待正文的时间；复杂分析可改为 true。
GLM_ENABLE_THINKING=false
GLM_MAX_TOKENS=4096
GLM_TIMEOUT_SECONDS=120
GLM_MAX_CONCURRENCY=2
GLM_TEMPERATURE=0.2

CODE_CONVERSION_STORAGE_DIR=storage/code-conversion
CODE_CONVERSION_MAX_UPLOAD_BYTES=536870912
CODE_CONVERSION_MAX_SOURCE_BYTES=2097152
CODE_CONVERSION_MAX_SOURCE_FILES=32
CODE_CONVERSION_MODEL=glm
CODE_CONVERSION_MAX_TOKENS=12000
CODE_CONVERSION_TIMEOUT_SECONDS=180
CODE_CONVERSION_MAX_CONCURRENCY=1
CODE_CONVERSION_TEMPERATURE=0.1

KNOWLEDGE_BASE_PATH=列车故障诊断经验知识库.md
KNOWLEDGE_BASE_DIR=knowledge-bases
KNOWLEDGE_MAX_UPLOAD_BYTES=10485760
KNOWLEDGE_TOP_K=5
KNOWLEDGE_HISTORY_TURNS=6
KNOWLEDGE_REWRITE_FOLLOWUPS=true
KNOWLEDGE_EVIDENCE_CHECK=model
KNOWLEDGE_CONTROL_TIMEOUT_SECONDS=12

# 检索链路独立于生成模型配置；keyword / vector / hybrid。
KNOWLEDGE_RETRIEVAL_MODE=hybrid
KNOWLEDGE_CANDIDATE_K=20
KNOWLEDGE_BM25_RECALL_K=20
KNOWLEDGE_DENSE_RECALL_K=20
KNOWLEDGE_RRF_K=60
KNOWLEDGE_EMBEDDING_MODEL=qwen3.7-text-embedding
KNOWLEDGE_EMBEDDING_DIMENSIONS=1024
KNOWLEDGE_EMBEDDING_BATCH_SIZE=20
KNOWLEDGE_EMBEDDING_CACHE_PATH=storage/rag/embeddings.sqlite3
KNOWLEDGE_VECTOR_STORE=milvus_lite
KNOWLEDGE_MILVUS_URI=storage/rag/milvus.db
KNOWLEDGE_INDEX_CATALOG_PATH=storage/rag/index_catalog.sqlite3
KNOWLEDGE_RERANK_ENABLED=true
KNOWLEDGE_RERANK_MODEL=qwen3.7-text-rerank
KNOWLEDGE_RETRIEVAL_TIMEOUT_SECONDS=30
# 留空时，从 DASHSCOPE_BASE_URL 自动推导同地域 DashScope HTTP 地址。
DASHSCOPE_HTTP_BASE_URL=

# 可选 Redis 召回/重排缓存；安装服务器专用 Redis 后启用。
KNOWLEDGE_CACHE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6380/0
KNOWLEDGE_CACHE_TTL_SECONDS=300
KNOWLEDGE_CACHE_NAMESPACE=control-center-rag
KNOWLEDGE_CACHE_TIMEOUT_SECONDS=0.2
KNOWLEDGE_CACHE_RETRY_SECONDS=30

AIDER_SOURCE_ROOT=../aider
AIDER_MODEL=openai/qwen3-coder-plus
AIDER_EDIT_FORMAT=diff
AIDER_AUTO_COMMITS=false

WORKSPACE_ROOT=..
ALLOWED_WORKSPACES=control-center-fe,control-center-be,transfer,communicate,aider-backend,code

JOB_WORKSPACE_ROOT=/home/mec-share-dc
JOB_LOG_POLL_INTERVAL=1.0
JOB_LOG_MAX_INITIAL_BYTES=65536

AGENT_API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088
LOG_LEVEL=INFO
